rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{boardId} {
      // Game state is readable by any signed-in user (they need a Firebase token to get here).
      allow read: if request.auth != null;
      allow write: if false;

      match /hands/{playerId} {
        // Each player can only read their own hand.
        allow read: if request.auth != null && request.auth.uid == playerId;
        allow write: if false;
      }

      match /secret/{document=**} {
        // Server-only — no client may read the deck.
        allow read, write: if false;
      }

      match /log/{eventId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }
  }
}
